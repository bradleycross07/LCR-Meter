# Normalise line endings: stored as LF in the repo, checked out natively
# (CRLF on Windows, LF on Linux/macOS).
* text=auto

# Always LF: these tools break on CRLF
*.sh      text eol=lf
Makefile  text eol=lf
*.mk      text eol=lf

# Windows-only scripts
*.bat     text eol=crlf

# Binary files: never diff or merge
*.png   binary
*.jpg   binary
*.pdf   binary
*.zip   binary
*.elf   binary
*.f3d   binary
*.f3z   binary
*.stl   binary
*.step  binary
*.stp   binary
*.xlsx  binary
*.docx  binary
